# Copy this file to .env and fill it in. Never share .env or paste it anywhere.

# Both are on your app's OAuth2 page in the Discord Developer Portal.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Optional. The bot token from the Bot page. With it, the server checks that
# everyone who connects really is in the activity they say they are in.
DISCORD_BOT_TOKEN=

# The port the server listens on. Most hosts set this for you.
PORT=3000
